<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: QA / harness commands. adb shell am broadcast -a io.embodit.spatialcalc.DEBUG -p io.embodit.spatialcalc -es cmd dump -->
        <receiver
            android:name=".platform.DebugCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.embodit.spatialcalc.DEBUG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
